<!--
File: split-pdf-hi.html
Description: Client‑side Hindi (Bollywood‑style) "Split PDF" tool. No server upload.
Tech: pdf.js (render + outline) + pdf-lib (rebuild) + JSZip (multi-file zip). Modes: Ranges, Every N pages, By Bookmarks (best‑effort), Odd/Even.
How to use: Save as a single HTML file and open in a modern browser. Add alongside index-hi.html.
-->
<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PDF बाँटो (Split) — रेंज, हर N पेज, बुकमार्क से</title>
  <meta name="description" content="PDF को हिस्सों में बाँटो — पेज रेंज, हर N पेज, बुकमार्क, Odd/Even। 100% ब्राउज़र में, कोई अपलोड नहीं।" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#0b1020; --card:#121935; --muted:#8ea0c9; --text:#e9eefb; --accent:#7c5cff; --accent-2:#23d3ac; --danger:#ff5c7c; --line: rgba(255,255,255,.10);
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; background:
        radial-gradient(1200px 800px at 80% -10%, rgba(124,92,255,.25), transparent),
        radial-gradient(900px 600px at 10% 110%, rgba(35,211,172,.18), transparent),
        var(--bg);
      color:var(--text); font-family:"Noto Sans Devanagari", system-ui, -apple-system, Segoe UI, Roboto, Arial;
      line-height:1.5;
    }
    header{display:flex; align-items:center; justify-content:space-between; padding:16px 20px; position:sticky; top:0; backdrop-filter:blur(6px); background:rgba(11,16,32,.6); border-bottom:1px solid var(--line)}
    .brand{display:flex; align-items:center; gap:10px; font-weight:800}
    .brand svg{width:28px;height:28px}
    .container{max-width:1100px; margin:28px auto; padding:0 16px}
    .card{background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.02)); border:1px solid var(--line); border-radius:18px; box-shadow:0 20px 70px rgba(0,0,0,.35); overflow:hidden}
    .hero{padding:26px 22px 0}
    h1{margin:0 0 8px; font-size:28px; font-weight:800}
    .sub{margin:0; color:var(--muted)}

    .uploader{border:1.5px dashed rgba(255,255,255,.18); border-radius:16px; padding:22px; margin:18px 22px; text-align:center; transition:.25s border-color}
    .uploader.dragover{border-color:var(--accent)}
    .uploader input[type=file]{display:none}
    .row{display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:center}
    .btn{appearance:none; border:none; border-radius:12px; padding:12px 14px; font-weight:700; cursor:pointer; color:#0b1020; background:var(--accent); box-shadow:0 8px 24px rgba(124,92,255,.35)}
    .btn.secondary{background:#1f2752; color:var(--text); box-shadow:none}
    .btn.ghost{background:transparent; color:var(--text); border:1px solid rgba(255,255,255,.18)}
    .btn.danger{background:var(--danger); color:#fff}

    .grid{display:grid; gap:14px; padding:0 22px 16px}
    .two{grid-template-columns:1fr 1fr}
    @media (max-width:900px){ .two{grid-template-columns:1fr} }

    .field{background:#0f1630; border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:12px}
    .field h4{margin:0 0 8px; font-size:14px}
    .field .muted{font-size:12px}
    input[type=number], input[type=text], select{background:#121935; color:var(--text); border:1px solid rgba(255,255,255,.14); border-radius:8px; padding:8px 10px; width:100%}

    .preview{display:grid; grid-template-columns:1fr 1fr; gap:12px; padding:0 22px 16px}
    @media (max-width:980px){ .preview{grid-template-columns:1fr} }
    .pv{background:#0f1630; border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:10px}
    .pv h4{margin:0 0 8px}
    .pv canvas{width:100%; height:auto; background:#0b1020; display:block; border:1px solid rgba(255,255,255,.06); border-radius:8px}
    .meta{color:var(--muted); font-size:13px}

    .actions{display:flex; justify-content:space-between; align-items:center; gap:12px; padding:14px 22px 18px; border-top:1px solid rgba(255,255,255,.06); background:rgba(255,255,255,.02)}
    .left,.right{display:flex; gap:8px; align-items:center; flex-wrap:wrap}

    .progress{height:8px; background:#0c1330; border-radius:999px; overflow:hidden; border:1px solid rgba(255,255,255,.12)}
    .bar{height:100%; width:0; background:linear-gradient(90deg, var(--accent), var(--accent-2)); transition:width .2s}

    .tiny{font-size:12px; color:var(--muted)}

    .howto{padding:0 22px 24px}
    .howto h3{margin:10px 0}
    .howto ol{margin:0 0 0 18px}

    .bookmark-box{max-height:240px; overflow:auto; background:#0e1734; border:1px solid rgba(255,255,255,.12); border-radius:10px; padding:8px; font-size:14px}
    .bookmark-box label{display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:8px}
    .bookmark-box label:hover{background:#101e4a}
  </style>
  <!-- libs -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"></script>
  <script defer src="https://unpkg.com/pdf-lib/dist/pdf-lib.min.js"></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
</head>
<body>
  <header>
    <div class="brand" aria-label="Brand">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7Z" stroke="currentColor" stroke-width="1.5"/><path d="M8 9h8M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span>PDF बाँटो — <span style="color:var(--accent-2)">हिंदी</span> टूल</span>
    </div>
    <div class="tiny">100% ब्राउज़र में • कोई अपलोड नहीं</div>
  </header>

  <main class="container">
    <section class="card" aria-labelledby="title">
      <div class="hero">
        <h1 id="title">PDF Split — रेंज, हर N पेज, बुकमार्क, Odd/Even</h1>
        <p class="sub">Office भेजने से पहले भारी PDF को हिस्सों में बाँटो, या चैप्टर‑वाइज़ PDF बनाओ। सब ब्राउज़र में, झटपट।</p>
      </div>

      <div class="uploader" id="drop" aria-label="फाइल जोड़ो" tabindex="0">
        <p style="margin:0 0 10px">फाइल यहाँ <strong>Drag & Drop</strong> करो या</p>
        <div class="row">
          <label class="btn" for="file">PDF चुनो</label>
          <button class="btn secondary" id="demoBtn" type="button">डेमो फाइल डालो</button>
        </div>
        <input id="file" type="file" accept="application/pdf" />
        <p class="tiny" style="margin-top:10px">टिप: बुकमार्क‑आधारित स्प्लिट तभी चलेगा जब PDF में आउटलाइन/बुकमार्क मौजूद हों।</p>
      </div>

      <section class="grid two" aria-label="मोड और सेटिंग्स">
        <div class="field">
          <h4>मोड चुनो</h4>
          <select id="mode">
            <option value="ranges" selected>रेंज से (e.g., 1-3,5,10-12)</option>
            <option value="nth">हर N पेज पर</option>
            <option value="bookmarks">बुकमार्क से (चैप्टर)</option>
            <option value="oddeven">Odd/Even पेज</option>
          </select>
          <div class="muted">ज़रूरत के हिसाब से मोड बदलो।</div>
        </div>
        <div class="field" id="rangesBox">
          <h4>पेज रेंज</h4>
          <input id="ranges" type="text" placeholder="उदा: 1-5,6-10,12,14-18"/>
          <div class="muted">हर रेंज एक आउटपुट PDF बनेगी।</div>
        </div>
        <div class="field" id="nthBox" hidden>
          <h4>हर N पेज</h4>
          <input id="nth" type="number" min="1" value="5"/>
          <div class="muted">उदा: N=5 ⇒ पेज 1‑5, 6‑10, 11‑15…</div>
        </div>
        <div class="field" id="bookmarksBox" hidden>
          <h4>बुकमार्क चुनो (टॉप‑लेवल)</h4>
          <div id="bmWrap" class="bookmark-box">PDF लोड करो — बुकमार्क दिखाई देंगे।</div>
          <div class="muted">चुने हुए बुकमार्क से अध्याय‑वार PDFs बनेंगी (best‑effort).</div>
        </div>
        <div class="field" id="oddevenBox" hidden>
          <h4>Odd/Even</h4>
          <select id="oeSel">
            <option value="odd">केवल Odd पेज</option>
            <option value="even">केवल Even पेज</option>
          </select>
          <div class="muted">एक PDF बनेगी — सिर्फ़ चुने हुए पेज।</div>
        </div>
      </section>

      <div class="preview">
        <div class="pv">
          <h4>प्रीव्यू: पहला पेज</h4>
          <canvas id="srcCanvas"></canvas>
          <div class="meta" id="srcMeta">—</div>
        </div>
        <div class="pv">
          <h4>जानकारी</h4>
          <div class="meta" id="docInfo">—</div>
        </div>
      </div>

      <div class="actions">
        <div class="left tiny" id="countLine">कोई फ़ाइल नहीं लोड हुई।</div>
        <div class="right">
          <button class="btn ghost" id="clearBtn" type="button" disabled>रीसेट</button>
          <button class="btn" id="splitBtn" type="button" disabled>स्प्लिट करो</button>
        </div>
      </div>

      <div style="padding:0 22px 18px; display:none" id="progressWrap">
        <div class="progress" aria-label="प्रोग्रेस"><div class="bar" id="bar"></div></div>
        <div class="tiny" id="status" style="margin-top:8px">तैयार हो रहे हैं…</div>
      </div>
    </section>

    <section class="card howto" id="howto">
      <h3>कैसे इस्तेमाल करें?</h3>
      <ol>
        <li>ऊपर PDF ड्रॉप/चुनो।</li>
        <li>मोड चुनो — <strong>रेंज</strong>, <strong>हर N पेज</strong>, <strong>बुकमार्क</strong>, या <strong>Odd/Even</strong>।</li>
        <li>सेटिंग भरकर <strong>स्प्लिट करो</strong> दबाओ — मल्टीपल PDFs <em>ZIP फाइल</em> में डाउनलोड होंगी (या सिंगल PDF सीधे)।</li>
      </ol>
      <p class="tiny">नोट: पासवर्ड‑प्रोटेक्टेड या स्कैन‑हेवी PDFs कुछ ब्राउज़र में सीमित हो सकते हैं।</p>
    </section>

    <p class="tiny" style="margin-top:12px">गोपनीयता: आपकी फाइलें कहीं अपलोड नहीं होतीं — सब कुछ आपके ब्राउज़र में होता है।</p>
  </main>

  <script>
  // ====== Lib setup ======
  const pdfjsLib = window['pdfjs-dist/build/pdf'];
  if (pdfjsLib) {
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  }

  // ====== State ======
  const S = { file:null, name:'', size:0, pageCount:0, pdf:null, outline:[], pageRefs:[] };
  const fileEl = document.getElementById('file');
  const dropEl = document.getElementById('drop');
  const splitBtn = document.getElementById('splitBtn');
  const clearBtn = document.getElementById('clearBtn');
  const demoBtn = document.getElementById('demoBtn');
  const countEl = document.getElementById('countLine');
  const progressWrap = document.getElementById('progressWrap');
  const barEl = document.getElementById('bar');
  const statusEl = document.getElementById('status');
  const srcCanvas = document.getElementById('srcCanvas');
  const srcMeta = document.getElementById('srcMeta');
  const docInfo = document.getElementById('docInfo');

  const modeSel = document.getElementById('mode');
  const rangesBox = document.getElementById('rangesBox');
  const nthBox = document.getElementById('nthBox');
  const bookmarksBox = document.getElementById('bookmarksBox');
  const oddevenBox = document.getElementById('oddevenBox');
  const rangesEl = document.getElementById('ranges');
  const nthEl = document.getElementById('nth');
  const bmWrap = document.getElementById('bmWrap');
  const oeSel = document.getElementById('oeSel');

  const fmtBytes = b => { if (b < 1024) return b + ' B'; const u=['KB','MB','GB']; let i=-1; do{ b/=1024; i++; }while(b>=1024 && i<u.length-1); return b.toFixed(1)+' '+u[i]; };

  // Mode switch UI
  modeSel.addEventListener('change', ()=>{
    const m = modeSel.value;
    rangesBox.hidden = m!=='ranges';
    nthBox.hidden = m!=='nth';
    bookmarksBox.hidden = m!=='bookmarks';
    oddevenBox.hidden = m!=='oddeven';
  });

  // File add
  fileEl.addEventListener('change', async (e)=>{ if(e.target.files[0]){ await loadFile(e.target.files[0]); fileEl.value=''; }});

  // Drag & Drop
  ;['dragenter','dragover'].forEach(ev=>dropEl.addEventListener(ev, e=>{e.preventDefault(); dropEl.classList.add('dragover');}));
  ;['dragleave','drop'].forEach(ev=>dropEl.addEventListener(ev, e=>{e.preventDefault(); dropEl.classList.remove('dragover');}));
  dropEl.addEventListener('drop', async (e)=>{
    const f = [...e.dataTransfer.files].find(f=>f.type==='application/pdf');
    if (f) await loadFile(f);
  });

  // Demo PDF (with bookmarks)
  demoBtn.addEventListener('click', async ()=>{
    const { PDFDocument, StandardFonts } = PDFLib;
    const doc = await PDFDocument.create();
    const font = await doc.embedFont(StandardFonts.Helvetica);
    for (let i=1;i<=12;i++){
      const p = doc.addPage([595,842]);
      p.drawText(`Demo Page ${i}`, { x: 220, y: 420, size: 28, font });
    }
    // Note: pdf-lib doesn't create bookmark outlines easily; this demo focuses on ranges/nth/odd-even
    const bytes = await doc.save();
    const blob = new Blob([bytes], {type:'application/pdf'});
    const file = new File([blob], 'Demo-Split.pdf', {type:'application/pdf'});
    await loadFile(file);
  });

  async function loadFile(file){
    resetUI();
    S.file=file; S.name=file.name; S.size=file.size;
    countEl.textContent = `${file.name} • ${fmtBytes(file.size)}`;
    splitBtn.disabled=false; clearBtn.disabled=false;

    try{
      const u8 = new Uint8Array(await file.arrayBuffer());
      const pdf = await pdfjsLib.getDocument({data:u8}).promise;
      S.pdf=pdf; S.pageCount=pdf.numPages;
      const page1 = await pdf.getPage(1);
      await renderToCanvas(page1, srcCanvas, 144);
      srcMeta.textContent = `पेज: 1/${pdf.numPages}`;
      docInfo.textContent = `कुल पेज: ${pdf.numPages} • फाइल: ${fmtBytes(S.size)}`;
      // Try outline
      try{
        const outline = await pdf.getOutline();
        if (outline && outline.length){
          S.outline = outline.filter(o=>o && o.dest); // top-level only
          await populateBookmarks(S.outline);
        } else {
          bmWrap.textContent = 'बुकमार्क नहीं मिले।';
        }
      }catch{ bmWrap.textContent = 'बुकमार्क नहीं पढ़ पाए।'; }
    }catch(err){ console.error(err); alert('फाइल नहीं खुली। शायद करप्ट या पासवर्ड‑प्रोटेक्टेड है।'); }
  }

  function resetUI(){
    srcCanvas.width=srcCanvas.height=0; srcMeta.textContent='—'; docInfo.textContent='—';
    splitBtn.disabled=true; clearBtn.disabled=true; bmWrap.innerHTML='PDF लोड करो — बुकमार्क दिखाई देंगे।';
  }

  async function renderToCanvas(page, canvas, dpi){
    const scale = dpi/72; const viewport = page.getViewport({scale});
    const ctx = canvas.getContext('2d', { willReadFrequently:true });
    canvas.width = Math.floor(viewport.width); canvas.height = Math.floor(viewport.height);
    await page.render({canvasContext: ctx, viewport}).promise;
  }

  async function populateBookmarks(items){
    // Convert outline dest to page numbers
    const pdf = S.pdf; if (!pdf) return;
    const rows = [];
    for (const it of items){
      try{
        const dest = await pdf.getDestination(it.dest);
        const ref = Array.isArray(dest) ? dest[0] : null;
        const pageIndex = ref ? await pdf.getPageIndex(ref) : null;
        if (pageIndex!=null){ rows.push({title: it.title || 'Untitled', page: pageIndex+1}); }
      }catch{}
    }
    if (!rows.length){ bmWrap.textContent='बुकमार्क नहीं मिले।'; return; }
    rows.sort((a,b)=>a.page-b.page);
    bmWrap.innerHTML = rows.map((r,i)=>`
      <label><input type="checkbox" data-page="${r.page}" checked> ${String(i+1).padStart(2,'0')}. ${escapeHtml(r.title)} — पेज ${r.page}</label>
    `).join('');
  }

  function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c])); }

  clearBtn.addEventListener('click', ()=>{ S.file=null; S.pdf=null; S.pageCount=0; resetUI(); countEl.textContent='कोई फ़ाइल नहीं लोड हुई।'; });
  splitBtn.addEventListener('click', split);

  function parseRangeList(str, max){
    // Ex: 1-3,6,8-10  → [[1,3],[6,6],[8,10]]
    const out=[]; if(!str) return out;
    for(const part of str.split(',').map(s=>s.trim()).filter(Boolean)){
      const m = part.match(/^(\d+)(?:\s*[-–]\s*(\d+))?$/); if(!m) throw new Error('format');
      let a = parseInt(m[1],10), b = m[2]? parseInt(m[2],10):a;
      if(a<1||b<1||a>max||b>max) throw new Error('range');
      if(a>b) [a,b]=[b,a];
      out.push([a,b]);
    }
    return normalizeRanges(out);
  }
  function normalizeRanges(ranges){
    // merge overlaps, sort
    ranges.sort((x,y)=>x[0]-y[0]);
    const out=[]; for(const r of ranges){
      if(!out.length || r[0] > out[out.length-1][1]+1) out.push([...r]);
      else out[out.length-1][1] = Math.max(out[out.length-1][1], r[1]);
    }
    return out;
  }

  async function split(){
    if(!S.pdf) return;
    const { PDFDocument } = PDFLib;
    progressWrap.style.display='block'; barEl.style.width='0%'; statusEl.textContent='तैयारी…';

    const mode = modeSel.value;
    const totalPages = S.pageCount;
    let jobs=[]; // each job: {label, start, end}

    try{
      if (mode==='ranges'){
        const list = parseRangeList((rangesEl.value||'').trim(), totalPages);
        if(!list.length){ alert('रेंज डालो: जैसे 1-5,6-10,12'); return; }
        jobs = list.map(([a,b],i)=>({label:`part-${i+1}_${a}-${b}`, start:a, end:b}));
      } else if (mode==='nth'){
        const n = Math.max(1, parseInt(nthEl.value||'5',10));
        for(let a=1,i=1; a<=totalPages; a+=n, i++){
          const b = Math.min(totalPages, a+n-1);
          jobs.push({label:`part-${i}_${a}-${b}`, start:a, end:b});
        }
      } else if (mode==='bookmarks'){
        const checks = [...bmWrap.querySelectorAll('input[type=checkbox]')].filter(x=>x.checked);
        if (!checks.length){ alert('कम से कम एक बुकमार्क चुनो।'); return; }
        const points = checks.map(c=>parseInt(c.dataset.page,10)).sort((a,b)=>a-b);
        for(let i=0;i<points.length;i++){
          const a = points[i]; const b = (i<points.length-1 ? points[i+1]-1 : totalPages);
          jobs.push({label:`chap-${i+1}_${a}-${b}`, start:a, end:b});
        }
      } else if (mode==='oddeven'){
        const pickEven = (oeSel.value==='even');
        // single output containing only odd or even pages
        jobs = [{ label: pickEven? 'even-pages' : 'odd-pages', start:1, end:totalPages, filter:(n)=> (pickEven? n%2===0 : n%2===1) }];
      }
    }catch(e){ alert('पेज रेंज/सेटिंग ग़लत है।'); return; }

    if (!jobs.length){ alert('कोई जॉब नहीं बना।'); return; }

    const multiple = !(jobs.length===1 && !jobs[0].filter);
    const zip = multiple ? new JSZip() : null;

    try{
      const srcBytes = new Uint8Array(await S.file.arrayBuffer());
      // For performance, reuse source & copy pages by indices with pdf-lib
      for (let ji=0; ji<jobs.length; ji++){
        const J = jobs[ji];
        statusEl.textContent = `बना रहे: ${J.label}`;
        const out = await PDFDocument.create();
        const src = await PDFDocument.load(srcBytes);
        const idxs = [];
        for(let p=J.start;p<=J.end;p++){ if(!J.filter || J.filter(p)) idxs.push(p-1); }
        const copied = await out.copyPages(src, idxs);
        copied.forEach(p=>out.addPage(p));
        const bytes = await out.save({ updateFieldAppearances:false });
        const fname = `${S.name.replace(/\.pdf$/i,'')}-${J.label}.pdf`;
        if (zip) zip.file(fname, bytes);
        else downloadBlob(new Blob([bytes], {type:'application/pdf'}), fname);
        barEl.style.width = Math.round(((ji+1)/jobs.length)*100)+'%';
      }

      if (zip){
        statusEl.textContent = 'ZIP बना रहे…';
        const z = await zip.generateAsync({type:'blob'});
        const stamp = new Date().toISOString().replace(/[:T]/g,'-').slice(0,19);
        downloadBlob(z, `${S.name.replace(/\.pdf$/i,'')}-split-${stamp}.zip`);
      }
      statusEl.textContent = 'हो गया! फाइलें डाउनलोड हो गईं।';
    }catch(err){
      console.error(err); alert('स्प्लिट नहीं हो पाया: '+(err?.message||err)); statusEl.textContent='एरर आया।';
    }
  }

  function downloadBlob(blob, name){ const a=document.createElement('a'); const url=URL.createObjectURL(blob); a.href=url; a.download=name; a.click(); URL.revokeObjectURL(url); }
  </script>
</body>
</html>
